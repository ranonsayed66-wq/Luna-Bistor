<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Luna Bistro | Restaurant</title>

<style>
:root{
  --bg:#10251d;
  --bg2:#17372b;
  --cream:#fffaf0;
  --surface:#f7f2e8;
  --gold:#d8a84e;
  --text:#17231e;
  --muted:#69746e;
  --white:#fff;
  --border:rgba(23,35,30,.12);
  --shadow:0 20px 50px rgba(16,37,29,.12);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--cream);
  color:var(--text);
  line-height:1.6;
}

button,input,select,textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

a{
  text-decoration:none;
  color:inherit;
}

.container{
  width:min(1120px,92%);
  margin:auto;
}

/* HEADER */

.header{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(255,250,240,.96);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
}

.nav{
  min-height:76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:25px;
  font-weight:800;
  letter-spacing:-1px;
}

.logo span{
  color:var(--gold);
}

nav{
  display:flex;
  align-items:center;
  gap:25px;
}

nav a{
  font-size:14px;
  font-weight:600;
}

nav a:hover{
  color:var(--gold);
}

.nav-button{
  border:0;
  background:var(--bg);
  color:white;
  padding:12px 20px;
  border-radius:30px;
}

.menu-toggle{
  display:none;
  border:0;
  background:transparent;
  font-size:27px;
}

/* HERO */

.hero{
  background:var(--cream);
  padding:90px 0 80px;
  overflow:hidden;
}

.hero-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:70px;
}

.eyebrow{
  color:var(--gold);
  font-size:12px;
  font-weight:800;
  letter-spacing:2px;
  margin-bottom:15px;
}

.hero h1{
  font-size:clamp(48px,7vw,78px);
  line-height:.98;
  letter-spacing:-4px;
  color:var(--bg);
}

.hero h1 span{
  display:block;
  color:var(--gold);
}

.hero-description{
  max-width:540px;
  margin:28px 0;
  color:var(--muted);
  font-size:17px;
}

.hero-buttons{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

.btn{
  border:0;
  border-radius:30px;
  padding:14px 23px;
  font-weight:700;
  display:inline-flex;
  align-items:center;
  justify-content:center;
}

.primary{
  background:var(--bg);
  color:white;
}

.primary:hover{
  background:var(--bg2);
}

.secondary{
  background:transparent;
  color:var(--bg);
  border:1px solid rgba(16,37,29,.25);
}

.secondary:hover{
  background:white;
}

.stats{
  display:flex;
  gap:35px;
  margin-top:45px;
}

.stats div{
  display:flex;
  flex-direction:column;
}

.stats strong{
  font-size:25px;
  color:var(--bg);
}

.stats span{
  color:var(--muted);
  font-size:12px;
}

/* HERO VISUAL */

.hero-visual{
  min-height:480px;
  background:var(--bg);
  border-radius:35px;
  position:relative;
  display:grid;
  place-items:center;
}

.plate{
  width:300px;
  height:300px;
  background:#e8dcc5;
  border:15px solid white;
  border-radius:50%;
  box-shadow:0 30px 70px rgba(0,0,0,.3);
  position:relative;
}

.food{
  position:absolute;
  border-radius:50%;
}

.food-one{
  width:85px;
  height:85px;
  background:#8a442c;
  left:65px;
  top:70px;
}

.food-two{
  width:60px;
  height:60px;
  background:#b87934;
  right:55px;
  top:65px;
}

.food-three{
  width:70px;
  height:70px;
  background:#54703d;
  left:105px;
  bottom:45px;
}

.food-four{
  width:42px;
  height:42px;
  background:#d8a84e;
  right:60px;
  bottom:55px;
}

.floating-card{
  position:absolute;
  right:25px;
  bottom:25px;
  background:white;
  padding:18px;
  border-radius:17px;
  box-shadow:var(--shadow);
  min-width:210px;
}

.floating-card span{
  color:var(--gold);
  font-size:11px;
  font-weight:800;
  text-transform:uppercase;
}

.floating-card strong{
  display:block;
  margin-top:4px;
  font-size:17px;
}

.floating-card small{
  color:var(--muted);
  font-size:11px;
}

/* MENU */

.menu-section{
  padding:100px 0;
  background:var(--surface);
}

.section-heading{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:40px;
  margin-bottom:40px;
}

.section-heading h2,
.about-text h2,
.special-box h2,
.contact-section h2{
  font-size:clamp(35px,5vw,55px);
  line-height:1;
  letter-spacing:-2px;
  color:var(--bg);
}

.section-heading>p{
  max-width:390px;
  color:var(--muted);
}

.filters{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-bottom:30px;
}

.filter{
  background:transparent;
  border:1px solid var(--border);
  padding:10px 17px;
  border-radius:30px;
  color:var(--text);
}

.filter.active,
.filter:hover{
  background:var(--bg);
  color:white;
}

.menu-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}

.menu-card{
  background:white;
  border-radius:20px;
  overflow:hidden;
  box-shadow:0 10px 35px rgba(16,37,29,.06);
  transition:transform .2s ease;
}

.menu-card:hover{
  transform:translateY(-5px);
}

.menu-card.hidden{
  display:none;
}

.dish-image{
  height:180px;
  display:grid;
  place-items:center;
  font-size:65px;
}

.burrata{background:#e6eadc}
.shrimp{background:#f3dfc8}
.pasta{background:#e7d8b8}
.steak{background:#dbc4b8}
.pizza{background:#ead4bd}
.chicken{background:#ded5b9}
.cheesecake{background:#eee1dc}
.drink{background:#d8e3d8}

.dish-content{
  padding:18px;
}

.dish-title{
  display:flex;
  justify-content:space-between;
  gap:10px;
}

.dish-title h3{
  font-size:17px;
}

.dish-title strong{
  color:var(--gold);
}

.dish-content p{
  color:var(--muted);
  font-size:13px;
  margin-top:8px;
}

/* ABOUT */

.about-section{
  padding:100px 0;
  background:var(--cream);
}

.about-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:80px;
  align-items:center;
}

.about-visual{
  min-height:430px;
  background:var(--bg);
  border-radius:35px;
  display:grid;
  place-items:center;
}

.about-box{
  width:230px;
  height:230px;
  border:1px solid rgba(255,255,255,.35);
  border-radius:50%;
  color:white;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
}

.about-box span{
  color:var(--gold);
  font-size:12px;
  letter-spacing:2px;
}

.about-box strong{
  font-size:60px;
  line-height:1;
}

.about-box small{
  margin-top:8px;
  letter-spacing:3px;
}

.about-text>p:not(.eyebrow){
  color:var(--muted);
  margin-top:20px;
}

.about-text ul{
  list-style:none;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-top:25px;
  font-weight:700;
}

/* SPECIAL */

.special-section{
  padding:35px 0;
  background:var(--surface);
}

.special-box{
  background:var(--bg);
  color:white;
  border-radius:30px;
  padding:50px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
}

.special-box h2{
  color:white;
}

.special-box p:not(.eyebrow){
  color:rgba(255,255,255,.7);
  margin-top:15px;
  max-width:550px;
}

.special-price{
  text-align:center;
  min-width:130px;
}

.special-price span{
  display:block;
  font-size:12px;
  color:rgba(255,255,255,.65);
}

.special-price strong{
  color:var(--gold);
  font-size:45px;
}

/* REVIEWS */

.reviews{
  padding:100px 0;
  background:var(--cream);
}

.centered{
  display:block;
  text-align:center;
}

.review-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.review{
  background:white;
  padding:28px;
  border-radius:20px;
}

.review>div{
  color:var(--gold);
  letter-spacing:3px;
}

.review p{
  margin:20px 0;
  color:var(--muted);
}

.review strong{
  color:var(--bg);
}

/* CONTACT */

.contact-section{
  padding:100px 0;
  background:var(--surface);
}

.contact-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:80px;
}

.contact-section>.container>div:first-child>p:not(.eyebrow){
  color:var(--muted);
  margin-top:20px;
  max-width:450px;
}

.contact-info{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:25px;
}

.contact-info div{
  border-top:1px solid var(--border);
  padding-top:15px;
}

.contact-info span{
  display:block;
  color:var(--gold);
  font-size:10px;
  font-weight:800;
  letter-spacing:1.5px;
  margin-bottom:6px;
}

.contact-info strong{
  font-size:14px;
}

/* FOOTER */

footer{
  background:var(--bg);
  color:white;
  padding:35px 0;
}

.footer-content{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

footer .logo{
  color:white;
}

footer p{
  color:rgba(255,255,255,.6);
  font-size:12px;
}

/* MODAL */

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  display:none;
  place-items:center;
  padding:20px;
  z-index:300;
}

.modal.open{
  display:grid;
}

.modal-content{
  width:min(500px,100%);
  background:var(--cream);
  border-radius:25px;
  padding:35px;
  position:relative;
  max-height:90vh;
  overflow-y:auto;
}

.modal-content h2{
  color:var(--bg);
  font-size:35px;
  margin-bottom:25px;
}

.modal-close{
  position:absolute;
  right:18px;
  top:15px;
  width:38px;
  height:38px;
  border:0;
  border-radius:50%;
  background:white;
  font-size:25px;
}

form{
  display:grid;
  gap:16px;
}

label{
  font-size:13px;
  font-weight:700;
}

input,select,textarea{
  width:100%;
  border:1px solid var(--border);
  background:white;
  border-radius:12px;
  padding:12px;
  margin-top:6px;
  outline:none;
}

input:focus,
select:focus,
textarea:focus{
  border-color:var(--gold);
}

textarea{
  min-height:90px;
  resize:vertical;
}

.full{
  width:100%;
}

#formMessage{
  color:var(--bg);
  font-weight:700;
  font-size:13px;
}

/* BACK TO TOP */

.back-top{
  position:fixed;
  right:20px;
  bottom:20px;
  width:45px;
  height:45px;
  border:0;
  border-radius:50%;
  background:var(--bg);
  color:white;
  font-size:20px;
  display:none;
  z-index:150;
}

.back-top.show{
  display:block;
}

/* MOBILE */

@media(max-width:850px){

  .menu-toggle{
    display:block;
  }

  nav{
    display:none;
    position:absolute;
    top:76px;
    left:0;
    right:0;
    background:var(--cream);
    padding:20px;
    flex-direction:column;
    border-bottom:1px solid var(--border);
  }

  nav.open{
    display:flex;
  }

  .hero-grid,
  .about-grid,
  .contact-grid{
    grid-template-columns:1fr;
  }

  .hero-grid{
    gap:40px;
  }

  .menu-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .review-grid{
    grid-template-columns:1fr;
  }

  .special-box{
    flex-direction:column;
    align-items:flex-start;
  }
}

@media(max-width:600px){

  .hero{
    padding:60px 0;
  }

  .hero h1{
    font-size:48px;
  }

  .stats{
    gap:20px;
  }

  .hero-visual{
    min-height:360px;
  }

  .plate{
    width:230px;
    height:230px;
  }

  .floating-card{
    right:15px;
    bottom:15px;
  }

  .menu-grid{
    grid-template-columns:1fr;
  }

  .section-heading{
    display:block;
  }

  .section-heading>p{
    margin-top:20px;
  }

  .contact-info{
    grid-template-columns:1fr;
  }

  .special-box{
    padding:30px;
  }

  .footer-content{
    flex-direction:column;
    align-items:flex-start;
  }
}
</style>
</head>


<body>

<header class="header">

  <div class="container nav">

    <a href="#home" class="logo">
      Luna<span>Bistro</span>
    </a>

    <button class="menu-toggle" id="menuToggle">
      ☰
    </button>

    <nav id="navLinks">

      <a href="#home">Home</a>
      <a href="#menu">Menu</a>
      <a href="#about">About</a>
      <a href="#special">Specials</a>
      <a href="#contact">Contact</a>

      <button class="nav-button" data-open-booking>
        Book a Table
      </button>

    </nav>

  </div>

</header>


<main>

<section class="hero" id="home">

  <div class="container hero-grid">

    <div class="hero-text">

      <p class="eyebrow">
        WELCOME TO LUNA BISTRO
      </p>

      <h1>
        Good food.
        <span>Beautiful moments.</span>
      </h1>

      <p class="hero-description">
        A modern restaurant in Cairo serving fresh ingredients,
        comforting flavors, and memorable dining experiences.
      </p>

      <div class="hero-buttons">

        <a href="#menu" class="btn primary">
          Explore Menu
        </a>

        <button class="btn secondary" data-open-booking>
          Reserve a Table
        </button>

      </div>


      <div class="stats">

        <div>
          <strong>4.9</strong>
          <span>Guest Rating</span>
        </div>

        <div>
          <strong>8+</strong>
          <span>Signature Dishes</span>
        </div>

        <div>
          <strong>7</strong>
          <span>Days Open</span>
        </div>

      </div>

    </div>


    <div class="hero-visual">

      <div class="plate">

        <div class="food food-one"></div>
        <div class="food food-two"></div>
        <div class="food food-three"></div>
        <div class="food food-four"></div>

      </div>


      <div class="floating-card">

        <span>Chef's Pick</span>

        <strong>Truffle Pasta</strong>

        <small>
          Fresh pasta · Parmesan · Truffle
        </small>

      </div>

    </div>

  </div>

</section>


<section class="menu-section" id="menu">

  <div class="container">

    <div class="section-heading">

      <div>

        <p class="eyebrow">
          OUR MENU
        </p>

        <h2>
          Made with care.
        </h2>

      </div>

      <p>
        From light starters to satisfying mains,
        every plate is prepared with fresh ingredients.
      </p>

    </div>


    <div class="filters">

      <button class="filter active" data-category="all">
        All
      </button>

      <button class="filter" data-category="starters">
        Starters
      </button>

      <button class="filter" data-category="mains">
        Mains
      </button>

      <button class="filter" data-category="pizza">
        Pizza
      </button>

      <button class="filter" data-category="desserts">
        Desserts
      </button>

      <button class="filter" data-category="drinks">
        Drinks
      </button>

