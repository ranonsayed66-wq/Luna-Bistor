      </p>

      <ul>

        <li>
          ✓ Fresh ingredients
        </li>

        <li>
          ✓ Daily prepared dishes
        </li>

        <li>
          ✓ Warm atmosphere
        </li>

        <li>
          ✓ Friendly service
        </li>

      </ul>

    </div>

  </div>

</section>


<section class="special-section" id="special">

  <div class="container special-box">

    <div>

      <p class="eyebrow">
        WEEKEND SPECIAL
      </p>

      <h2>
        Chef's Tasting Night
      </h2>

      <p>
        A special selection of our chef's favorite dishes,
        served every weekend.
      </p>

    </div>


    <div class="special-price">

